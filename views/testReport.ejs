<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PREPTO - Test Report</title>
    <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap");

        :root {
            --primary-color: #3b141c;
            --secondary-color: #f3961c;
            --dark-color: #252525;
            --white-color: #fff;
            --light-gray-color: #f2f2f2;
            --gradient: linear-gradient(135deg, #f3961c, #d98512);
        }

        * { margin:0; padding:0; box-sizing:border-box; font-family:"Poppins", sans-serif; }
        body { background-color: var(--light-gray-color); }

        a { text-decoration:none; color:inherit; }

        /* Sidebar */
        .nav {
            position: fixed;
            top:0; left:0;
            width: 250px; height: 100vh;
            background-color: var(--primary-color);
            color: var(--white-color);
            padding:20px;
            display:flex; flex-direction:column; align-items:center;
            box-shadow: 2px 0 5px rgba(0,0,0,0.2);
        }

        .nav_logo { margin-bottom:20px; }
        .nav_logo a { display:flex; align-items:center; gap:10px; }
        .nav_logo img { width:40px; height:40px; border-radius:50%; object-fit:cover; }
        .nav_logo h2 { font-size:24px; font-weight:600; color: var(--white-color); }

        .nav ul { width:100%; list-style:none; padding:0; }
        .nav ul li a { display:flex; align-items:center; gap:10px; padding:10px 15px; border-radius:8px; transition:0.2s; }
        .nav ul li a:hover { background-color: var(--secondary-color); color: var(--primary-color); }
        .nav ul li a i { font-size:20px; width:24px; text-align:center; }
        .nav ul li a span { font-size:16px; }

        .logout { margin-top:auto; margin-bottom:20px; }

        /* Main Content */
        .main { margin-left:250px; padding:40px; min-height:100vh; }

        h2.page-title {
            font-size:32px; font-weight:700; 
            background: var(--gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-align:center;
            margin-bottom:30px;
        }

        .report-card {
            background: #fff;
            border-radius: 15px;
            padding: 30px 40px;
            max-width: 900px;
            margin:auto;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .report-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }

        .meta {
            background: #fff6e8;
            padding: 20px;
            border-left: 5px solid var(--secondary-color);
            border-radius: 8px;
            margin-bottom: 30px;
            box-shadow: inset 0 1px 5px rgba(0,0,0,0.05);
        }

        .meta p { margin: 8px 0; font-size:16px; color:#333; }

        .report-content {
            line-height:1.7;
            font-size:16px;
            color:#444;
            white-space: pre-wrap;
        }

        a.button {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 22px;
            background: var(--secondary-color);
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 500;
            transition: 0.2s;
        }

        a.button:hover { background:#d98512; }

        /* Responsive */
        @media (max-width:768px) {
            .nav { width:100%; height:auto; position:static; flex-direction:row; justify-content:space-between; padding:10px; }
            .main { margin-left:0; padding:20px; }
            .report-card { padding:20px; }
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="nav">
      <div class="nav_logo">
          <a href="/dashboard">
              <img src="/images/WhatsApp Image 2025-03-01 at 07.23.51_0acb7dd0.jpg" alt="Prepto Logo">
              <h2>Prepto</h2>
          </a>
      </div>

      <ul>
           <li><a href="/analyze"><i class="fas fa-file-alt"></i><span>ATS Score</span></a></li>
            <li><a href="/resume-builder"><i class="fas fa-file-pdf"></i><span>Resume Builder</span></a></li>
            <li><a href="/reports"><i class="fas fa-file-invoice"></i><span>Reports</span></a></li>
            <li><a href="/progress"><i class="fas fa-chart-bar"></i><span>Progress</span></a></li>
            <li><a href="/mock-interviews"><i class="fas fa-microphone"></i><span>Mock Interviews</span></a></li>
            <li><a href="/api/mockTest"><i class="fas fa-pencil-alt"></i><span>Mock Tests</span></a></li>
            <li><a href="/careerguidance"><i class="fas fa-graduation-cap"></i><span>Career Guidance</span></a></li>
            <li><a href="/resume-interview"><i class="fas fa-question-circle"></i><span>Interview Prep</span></a></li>
            <li class="logout"><a href="/logout"><i class="fas fa-sign-out-alt"></i><span>Logout</span></a></li>
      </ul>
  </div>

    <!-- Main Content -->
    <div class="main">
        <h2 class="page-title"><%= type %> Report</h2>

        <div class="report-card">
            <div class="meta">
                <p><strong>Sub Test:</strong> <%= sub || '-' %></p>
                <p><strong>Score:</strong> <%= score %></p>
                <p><strong>Submitted At:</strong> <%= submittedAt %></p>
            </div>

            <div>
                <%- fullReport %>
            </div>

            <a href="/reports" class="button">Back</a>
        </div>
    </div>

</body>
</html>
