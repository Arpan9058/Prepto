<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Interview session · Prepto</title><link rel="stylesheet" href="/stylesheet/product.css"><script defer src="/productCommon.js"></script><script defer src="/interviewSession.js"></script></head><body class="product" data-session-id="<%= sessionId %>"><%- include('partials/productNav') %><main><p class="eyebrow">Focused practice</p><h1 id="session-title">Your interview</h1><p id="session-meta" class="subtle"></p><div id="status" class="state" role="status" aria-live="polite">Loading interview…</div><div class="toolbar"><button id="pause" hidden>Pause</button><button id="resume" hidden>Resume interview</button><button id="complete" hidden>Complete and save report</button><button id="refresh" class="secondary">Refresh</button><a href="/interviews">All sessions</a></div><section id="current-question" class="card" hidden><span id="question-number" class="badge"></span><h2 id="question-title"></h2><p id="question-prompt"></p><form id="answer-form" class="stack"><label id="text-answer">Your answer<textarea name="text" maxlength="4000" required></textarea></label><label id="choice-answer" hidden>Your answer<select name="choice"></select></label><button type="submit">Save answer and get feedback</button></form></section><section><h2>Saved answers and feedback</h2><div id="answers" class="stack"></div></section></main></body></html>
