<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Resume versions · Prepto</title><link rel="stylesheet" href="/stylesheet/product.css"><script defer src="/productCommon.js"></script><script defer src="/resumeVersions.js"></script></head><body class="product" data-resume-id="<%= resumeId %>"><%- include('partials/productNav') %><main><p class="eyebrow">Keep the original. Improve the next.</p><h1 id="resume-title">Your resume</h1><div id="status" class="state" role="status" aria-live="polite">Loading versions…</div><div class="row"><a href="/resumes">All resumes</a><button id="refresh-versions" class="secondary">Refresh</button></div><section><h2>Version history</h2><div id="versions" class="grid"></div><button id="more-versions" class="secondary" hidden>Load older versions</button></section><section class="card"><h2 id="selected-label">Selected version</h2><p id="version-meta" class="subtle"></p><pre id="resume-preview" style="white-space:pre-wrap;overflow-wrap:anywhere"></pre><div class="row"><button id="make-current" class="secondary" hidden>Use as current version</button><a id="download-version" class="button" hidden>Download this version as PDF</a></div></section><section class="card"><h2>Save an improved version</h2><form id="new-version" class="stack"><label>Version label<input name="label" maxlength="100" placeholder="Tailored for a backend role"></label><label>Edit the selected text<textarea name="text" maxlength="50000" rows="12"></textarea></label><label>Or upload an updated PDF / DOCX<input name="resume" type="file" accept=".pdf,.docx"></label><button type="submit">Save as a new version</button></form><p class="subtle">Saving creates an immutable version and makes it current. Older versions stay available.</p></section><section class="card"><h2>Match the selected version to a job</h2><p class="subtle">AI-assisted compatibility estimates help you identify gaps and improve your application.</p><form id="match-version" class="stack"><label>Job title<input name="jobTitle" maxlength="120" required></label><label>Job description<textarea name="jobDescription" maxlength="15000" rows="8" required></textarea></label><button type="submit">Match and save feedback</button></form><div id="match-result" class="stack" hidden></div><a href="/resume-matches">View matching history</a></section></main></body></html>
