<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Resume versions · Prepto</title><link rel="stylesheet" href="/stylesheet/product.css"><script defer src="/productCommon.js"></script><script defer src="/resumes.js"></script></head><body class="product"><%- include('partials/productNav') %><main><p class="eyebrow">A resume that grows with you</p><h1>Your experience. Better presented.</h1><p class="subtle">Keep private versions for each opportunity. Edit a copy, preserve the original and download any saved version.</p><div id="status" class="state" role="status" aria-live="polite">Loading resumes…</div><section class="card"><h2>Save your first version</h2><form id="create-resume" class="stack"><label>Resume title<input name="title" maxlength="120" placeholder="Backend engineering resume" required></label><label>Resume text<textarea name="text" maxlength="50000" placeholder="Paste your experience, skills and achievements"></textarea></label><label>Or upload PDF / DOCX (up to 5 MiB)<input name="resume" type="file" accept=".pdf,.docx"></label><label>Version label<input name="label" maxlength="100" placeholder="General version"></label><button type="submit">Save private resume</button><p class="subtle">Uploads are saved as extracted text. You can preview, edit and export that content as a new PDF.</p></form></section><div class="row pagination"><h2>Saved resumes</h2><button id="refresh-resumes" class="secondary">Refresh</button></div><section id="resumes" class="grid"></section><button id="more-resumes" class="secondary" hidden>Load more</button></main></body></html>
