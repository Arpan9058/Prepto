<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Coding practice · Prepto</title><link rel="stylesheet" href="/stylesheet/product.css"><script defer src="/productCommon.js"></script><script defer src="/codingPractice.js"></script></head><body class="product"><%- include('partials/productNav') %><main><h1>Coding practice</h1><p class="state">AI feedback only. Your code is not executed. Executable test results are unavailable.</p><div id="status" class="state" role="status" aria-live="polite">Loading problems…</div><form id="problem-filters" class="toolbar"><label>Search<input name="q" maxlength="100"></label><label>Category<select name="category"><option value="">All categories</option><option>arrays</option><option>strings</option><option>sorting</option></select></label><label>Difficulty<select name="difficulty"><option value="">All difficulties</option><option>easy</option><option>medium</option><option>hard</option></select></label><button>Filter problems</button></form><section id="problems" class="grid"></section><button id="more-problems" hidden>More problems</button><section id="workspace" class="card" hidden><h2 id="problem-title"></h2><p id="problem-prompt"></p><pre id="problem-examples" style="white-space:pre-wrap"></pre><label>Language<select id="code-language"><option value="javascript">JavaScript</option><option value="python">Python</option></select></label><label for="code-editor">Your solution (private draft)</label><textarea id="code-editor" rows="16" maxlength="30000" spellcheck="false" style="width:100%;font-family:monospace" aria-describedby="execution-note"></textarea><p id="execution-note">Do not paste secrets into code. Saving and AI review never run your code.</p><div class="row"><button id="save-code">Save draft</button><button id="submit-code">Submit for AI review</button><button id="reload-code" class="secondary">Reload saved draft</button></div><p id="draft-note"></p></section><section><h2>Your submissions</h2><button id="refresh-submissions" class="secondary">Refresh submissions</button><div id="coding-submissions" class="grid"></div><button id="more-submissions" hidden>More submissions</button></section><section id="coding-review" class="card" hidden><h2>Saved answer review</h2><div id="review-content"></div></section><a href="/progress">See practice history and AI estimate trends</a></main></body></html>
