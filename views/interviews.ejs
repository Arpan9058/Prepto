<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My interviews · Prepto</title><link rel="stylesheet" href="/stylesheet/product.css"><script defer src="/productCommon.js"></script><script defer src="/interviews.js"></script></head><body class="product"><%- include('partials/productNav') %><main id="main-content" tabindex="-1"><p class="eyebrow">Keep your momentum</p><h1>Your practice. Your pace.</h1><p class="subtle">Start a focused session, pause when life gets busy, and return to your saved answers and feedback.</p><div id="status" class="state" role="status" aria-live="polite">Loading interviews…</div><section class="card"><h2>Start an interview</h2><form id="start-interview" class="stack"><label>Session name<input name="title" value="Focused practice" required maxlength="100"></label><p>Choose 1–10 questions. For more choices, explore the <a href="/question-bank">question bank</a>.</p><div id="question-picker" class="grid"></div><div class="row"><button type="submit">Start practice</button><button type="button" id="more-questions" class="secondary" hidden>More questions</button></div></form></section><section><h2>Saved sessions</h2><div class="toolbar"><label>Status<select id="session-status"><option value="">All sessions</option><option value="active">Active</option><option value="paused">Paused</option><option value="completed">Completed</option></select></label><button id="refresh-sessions" class="secondary">Refresh</button></div><div id="sessions" class="grid"></div><button id="more-sessions" class="secondary" hidden>Load more sessions</button></section></main></body></html>
