# Node 24.12+ (24.19.0 pinned); copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# JSON string, not a filename; alternatively use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LOG_LEVEL=info
# Set true only behind a trusted, single-hop reverse proxy.
TRUST_PROXY=false
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# Only for an isolated container unable to run the Chromium sandbox.
CHROMIUM_NO_SANDBOX=false
# Export proxy variables BEFORE npm start (Node --use-env-proxy reads them at startup).
# HTTPS_PROXY=http://proxy-host:port
# HTTP_PROXY=http://proxy-host:port
# NO_PROXY=localhost,127.0.0.1
# grpc_proxy=http://proxy-host:port

# Explicit non-secret project safety pin for isolated live verification.
LIVE_FIREBASE_PROJECT_ID=

# Optional publishable Firebase browser config ONLY (not service-account JSON).
# Omit to retain the existing public web project settings. Never put Admin/Gemini/session secrets here.
# FIREBASE_WEB_CONFIG_JSON={"apiKey":"PUBLIC_WEB_KEY","authDomain":"project.firebaseapp.com","projectId":"project","appId":"PUBLIC_APP_ID"}

# Optional local Firestore emulator only; never set for live validation/production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8089

# Optional corporate CA PEM path; retain certificate verification. Leave unset normally.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/trusted-ca.pem
# Optional Docker smoke build network override for restricted local hosts only.
# PREPTO_DOCKER_BUILD_NETWORK=host
# Resolve the configured build proxy hostname on restricted Docker networks only.
# PREPTO_DOCKER_RESOLVE_PROXY=1

# Optional executable for the targeted offline Firefox smoke (not production Chromium).
# FIREFOX_EXECUTABLE_PATH=/usr/bin/firefox-esr
