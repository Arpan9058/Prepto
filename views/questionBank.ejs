<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Question bank · Prepto</title><link rel="stylesheet" href="/stylesheet/product.css"><script defer src="/productCommon.js"></script><script defer src="/questionBank.js"></script></head><body class="product" data-admin="<%= user.admin === true %>"><%- include('partials/productNav') %><main><p class="eyebrow">Build your knowledge</p><h1>One good question at a time.</h1><p class="subtle">Find a skill to work on, save questions for later and turn practice into progress.</p><form id="filters" class="toolbar"><label>Search titles or skills<input id="search" name="q" placeholder="One keyword, e.g. Node" minlength="2" maxlength="40"></label><label>Category<select id="category"><option value="">All categories</option><% categories.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %></select></label><label>Difficulty<select id="difficulty"><option value="">All levels</option><% difficulties.forEach(d => { %><option><%= d %></option><% }) %></select></label><button type="submit">Find questions</button><button type="button" id="bookmarks" class="secondary">Saved questions</button></form><div id="status" class="state" role="status" aria-live="polite">Loading questions…</div><section id="questions" class="grid" aria-label="Questions"></section><div class="row pagination"><button id="previous" class="secondary" disabled>Previous</button><span id="page-label">Page 1</span><button id="next" disabled>Next</button></div><% if (user.admin === true) { %><section class="card admin-panel"><h2>Question management</h2><p>Only verified administrators can publish, edit or archive questions.</p><button id="new-question">Create question</button><button id="archived" class="secondary">View archived</button></section><dialog id="editor"><form id="question-form" class="stack"><h2 id="editor-title">Create question</h2><label>Title<input name="title" maxlength="140" required></label><label>Prompt<textarea name="prompt" maxlength="4000" required></textarea></label><label>Category<select name="category"><% categories.forEach(c => { %><option><%= c %></option><% }) %></select></label><label>Difficulty<select name="difficulty"><% difficulties.forEach(d => { %><option><%= d %></option><% }) %></select></label><label>Type<select name="type"><option value="openEnded">Open ended</option><option value="multipleChoice">Multiple choice</option></select></label><label>Skills (comma separated)<input name="skills" required></label><label>Options (one per line, multiple choice only)<textarea name="options"></textarea></label><label>Correct option (multiple choice only)<input name="answer"></label><label>Model answer / explanation<textarea name="explanation" required maxlength="4000"></textarea></label><p id="editor-error" role="alert"></p><div class="row"><button type="submit">Publish changes</button><button type="button" id="close-editor" class="secondary">Cancel</button></div></form></dialog><% } %></main></body></html>
