<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Saved reports · Prepto</title><link rel="stylesheet" href="/stylesheet/product.css"><script defer src="/productCommon.js"></script></head><body class="product"><%- include('partials/productNav') %><main id="main-content" tabindex="-1"><h1>Saved reports</h1><p class="subtle">Return to your completed practice. Coding AI estimates are not executable test results.</p><% if(!reports.length) { %><p class="state">No saved reports yet. Complete a practice interview or request coding AI feedback to start.</p><a class="button" href="/interviews">Start practice</a><% } else { %><div class="table-wrap" tabindex="0" role="region" aria-label="Saved reports table"><table><thead><tr><th scope="col">Practice</th><th scope="col">Category</th><th scope="col">Score / estimate</th><th scope="col">Submitted</th><th scope="col">Actions</th></tr></thead><tbody><% reports.forEach(r => { const query = '?type=' + encodeURIComponent(r.type) + (r.subTest ? '&sub=' + encodeURIComponent(r.subTest) : ''); %><tr><td><%= r.type %></td><td><%= r.subTest || '—' %></td><td><%= r.score %></td><td><%= r.submittedAt %></td><td><a href="/reports/view/<%= r.id %><%= query %>" aria-label="View <%= r.type %> report from <%= r.submittedAt %>">View</a> · <a href="/reports/download/<%= r.id %><%= query %>" aria-label="Download <%= r.type %> report from <%= r.submittedAt %>">Download JSON</a></td></tr><% }); %></tbody></table></div><% } %></main></body></html>
