<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PREPTO | HR Interview Round</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
    <script src="https://cdn.autoproctor.co/ap-entry.js"></script>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            background: #f2f2f2;
            font-family: "Poppins", sans-serif;
        }

        .prepto-header {
            background: #3b141c;
            padding: 25px 0;
            text-align: center;
            color: #fff;
        }

        .prepto-section {
            max-width: 950px;
            margin: 40px auto;
            background: white;
            padding: 40px;
            border-radius: 14px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.1);
        }

        .question-box {
            background: #fff7ec;
            padding: 18px 22px;
            border-left: 5px solid #f3961c;
            border-radius: 8px;
            font-size: 1.2rem;
            font-weight: 600;
            color: #3b141c;
            margin-bottom: 25px;
        }

        .prepto-btn {
            background: #f3961c;
            color: white;
            border-radius: 30px;
            padding: 12px 32px;
            font-weight: 600;
            transition: 0.25s;
            cursor: pointer;
            border: none;
            font-size: 1rem;
        }

        .prepto-btn:hover {
            background: #d07a10;
        }

        .prepto-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        .transcription-box {
            background: #f9f9f9;
            padding: 20px;
            border-radius: 12px;
            border: 1px solid #ddd;
            min-height: 150px;
            max-height: 260px;
            overflow-y: auto;
            margin-bottom: 25px;
            font-size: 0.95rem;
            color: #333;
        }

        .result-card {
            background: #fff7ec;
            padding: 18px;
            border-radius: 10px;
            border-left: 5px solid #f3961c;
            margin-bottom: 18px;
        }

        .result-card p strong {
            color: #3b141c;
        }

        /* Recording pulse indicator */
        .recording-indicator {
            display: inline-block;
            width: 12px;
            height: 12px;
            background: red;
            border-radius: 50%;
            margin-right: 8px;
            animation: pulse 1s infinite;
            vertical-align: middle;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.2; }
        }

        .status-bar {
            text-align: center;
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 10px;
            min-height: 20px;
        }

        .question-counter {
            font-size: 0.85rem;
            color: #888;
            text-align: right;
            margin-bottom: 8px;
        }
    </style>
</head>

<body>

    <!-- PAGE HEADER -->
    <header class="prepto-header">
        <h1 class="text-3xl font-bold">HR Interview Round</h1>
        <p class="opacity-80 mt-1">Speak confidently — our AI will guide the conversation.</p>
    </header>

    <!-- MAIN INTERVIEW SECTION -->
    <section class="prepto-section">

        <!-- Question Counter -->
        <div id="questionCounter" class="question-counter">Question 1 of 10</div>

        <!-- Display Question -->
        <div id="questionDisplay" class="question-box">
            Loading question...
        </div>

        <!-- Recording Status -->
        <div id="statusBar" class="status-bar"></div>

        <!-- Start/Stop Button -->
        <div class="text-center mb-6">
            <button id="startStopButton" class="prepto-btn">🎙 Start Recording</button>
        </div>

        <!-- Transcription Output -->
        <h2 class="text-xl font-semibold mb-2 text-gray-800">Your Transcription</h2>
        <div id="transcription" class="transcription-box">
            <span style="color:#aaa;">Your speech will appear here...</span>
        </div>

        <!-- Interview Results -->
        <div id="interviewResults" class="mt-10"></div>

    </section>


<script>
    const startStopButton = document.getElementById('startStopButton');
    const transcriptionDiv = document.getElementById('transcription');
    const questionDisplay = document.getElementById('questionDisplay');
    const interviewResultsDiv = document.getElementById('interviewResults');
    const statusBar = document.getElementById('statusBar');
    const questionCounterDiv = document.getElementById('questionCounter');

    let recognition;
    let isRecording = false;

    // FIX: Keep a persistent running transcript so auto-restart doesn't wipe it
    let finalTranscript = '';
    let interimTranscript = '';

    let isTranscriptionSent = false;
    let questionCounter = 0;
    const maxQuestions = 9; // 0-indexed, so 10 questions total (0 through 9)
    let interviewData = [];
    let currentQuestion = "";
    let interviewComplete = false;

    const SENTINEL = "Thank you, that concludes this question.";

    // ─── MIC ACCESS ───────────────────────────────────────────────
    async function getMedia() {
        try {
            await navigator.mediaDevices.getUserMedia({ audio: true });
        } catch (err) {
            statusBar.textContent = "⚠️ Microphone access denied.";
            startStopButton.disabled = true;
        }
    }

    // ─── SPEECH RECOGNITION SETUP ─────────────────────────────────
    function initRecognition() {
        if ('webkitSpeechRecognition' in window) {
            recognition = new webkitSpeechRecognition();
        } else if ('SpeechRecognition' in window) {
            recognition = new SpeechRecognition();
        } else {
            transcriptionDiv.textContent = 'Speech Recognition is not supported in this browser.';
            startStopButton.disabled = true;
            return false;
        }

        recognition.continuous = true;
        recognition.interimResults = true;
        recognition.lang = 'en-US';

        recognition.onstart = function () {
            // FIX: Don't clear transcript here — only clear on a fresh manual start
            // (handled in startRecognition below)
            statusBar.innerHTML = '<span class="recording-indicator"></span> Recording...';
        };

        recognition.onerror = function (event) {
            console.error("Recognition error:", event.error);
            // Don't stop on 'no-speech' — just keep going
            if (event.error === 'no-speech' || event.error === 'audio-capture') {
                return;
            }
            statusBar.textContent = `⚠️ Error: ${event.error}`;
        };

        // FIX: onend fires on silence/timeout — DO NOT submit here.
        // Instead, restart recognition if user is still supposed to be recording.
        recognition.onend = function () {
            if (isRecording && !isTranscriptionSent && !interviewComplete) {
                // Auto-restart to keep the mic alive
                try {
                    recognition.start();
                } catch(e) {
                    // Already started, ignore
                }
            } else {
                statusBar.textContent = '';
            }
        };

        recognition.onresult = function (event) {
            interimTranscript = '';

            for (let i = event.resultIndex; i < event.results.length; i++) {
                if (event.results[i].isFinal) {
                    finalTranscript += event.results[i][0].transcript + ' ';
                } else {
                    interimTranscript += event.results[i][0].transcript;
                }
            }

            // Show final (solid) + interim (greyed out) text
            transcriptionDiv.innerHTML =
                finalTranscript +
                `<span style="color:#aaa;">${interimTranscript}</span>`;
        };

        return true;
    }

    // ─── START ─────────────────────────────────────────────────────
    function startRecognition() {
        if (!initRecognition()) return;

        // FIX: Only clear transcript on a deliberate fresh start by user
        finalTranscript = '';
        interimTranscript = '';
        isTranscriptionSent = false;
        transcriptionDiv.innerHTML = '<span style="color:#aaa;">Listening...</span>';

        isRecording = true;
        startStopButton.textContent = '⏹ Stop Recording';

        try {
            recognition.start();
        } catch(e) {
            console.error(e);
        }
    }

    // ─── STOP ──────────────────────────────────────────────────────
    function stopRecognition() {
        isRecording = false;
        startStopButton.textContent = '🎙 Start Recording';
        statusBar.textContent = 'Processing...';

        if (recognition) recognition.stop();

        // FIX: Submit only if there's actual content and hasn't been sent already
        const trimmed = finalTranscript.trim();
        if (trimmed && !isTranscriptionSent) {
            isTranscriptionSent = true;
            startStopButton.disabled = true; // prevent double-clicks while sending
            sendTranscriptionToBackend(trimmed);
        } else if (!trimmed) {
            statusBar.textContent = '⚠️ No speech detected. Please try again.';
        }
    }

    // ─── SEND TO BACKEND ───────────────────────────────────────────
    async function sendTranscriptionToBackend(text) {
        try {
            statusBar.textContent = '⏳ Analyzing your answer...';

            const response = await fetch('/hr-round/analyze-text', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    text: text,
                    question: currentQuestion,
                    questionCounter: questionCounter
                })
            });

            const data = await response.json();

            interviewData.push({
                question: currentQuestion,
                answer: text,
                analysis: data.analysis
            });

            isTranscriptionSent = false;
            finalTranscript = '';
            interimTranscript = '';

            // FIX: Check >= maxQuestions (not >) to properly catch the last question
            if (questionCounter >= maxQuestions) {
                endInterview();
                return;
            }

            // FIX: Detect sentinel string and end interview instead of showing it as a question
            if (
                !data.followUpQuestion ||
                !data.followUpQuestion.question ||
                data.followUpQuestion.question === SENTINEL
            ) {
                endInterview();
                return;
            }

            // Move to next question
            questionCounter++;
            currentQuestion = data.followUpQuestion.question;
            questionDisplay.textContent = currentQuestion;
            questionCounterDiv.textContent = `Question ${questionCounter + 1} of 10`;

            // Reset UI for next answer
            transcriptionDiv.innerHTML = '<span style="color:#aaa;">Your speech will appear here...</span>';
            statusBar.textContent = '✅ Answer recorded. Start recording for the next question.';
            startStopButton.disabled = false;
            startStopButton.textContent = '🎙 Start Recording';

        } catch (error) {
            console.error(error);
            statusBar.textContent = '❌ Error sending answer. Please try again.';
            startStopButton.disabled = false;
            isTranscriptionSent = false;
        }
    }

    // ─── END INTERVIEW ─────────────────────────────────────────────
    function endInterview() {
        interviewComplete = true;
        startStopButton.disabled = true;
        startStopButton.textContent = '✅ Interview Complete';
        questionDisplay.textContent = '🎉 Interview complete! See your results below.';
        questionCounterDiv.textContent = '';
        statusBar.textContent = '';
        displayInterviewResults();
    }

    // ─── DISPLAY RESULTS ───────────────────────────────────────────
    function displayInterviewResults() {
        let html = `<h2 class="text-2xl font-bold mb-4 text-gray-800">📊 Interview Results</h2>`;
        let total = 0;
        let count = 0;

        interviewData.forEach((item, i) => {
            const score = item.analysis?.score ?? null;
            const scoreColor = score >= 4 ? 'green' : score >= 2 ? 'orange' : 'red';

            html += `
                <div class="result-card">
                    <h3 class="font-semibold text-lg mb-2">Q${i + 1}: ${item.question}</h3>
                    <p class="mb-1"><strong>Your Answer:</strong> ${item.answer}</p>
                    ${
                        item.analysis
                            ? `<p class="mb-1"><strong>Score:</strong> <span style="color:${scoreColor}; font-weight:bold;">${score} / 5</span></p>
                               <p class="mb-1"><strong>Analysis:</strong> ${item.analysis.analysis}</p>
                               <p><strong>Recommendation:</strong> ${item.analysis.recommendation}</p>`
                            : "<p>No analysis available.</p>"
                    }
                </div>
            `;

            if (score !== null) {
                total += score;
                count++;
            }
        });

        if (count > 0) {
            const maxPossible = count * 5;
            const percentage = ((total / maxPossible) * 100).toFixed(1);
            html += `
                <div style="background:#3b141c; color:white; padding:20px; border-radius:10px; text-align:center; margin-top:10px;">
                    <p class="text-xl font-bold">Total Score: ${total} / ${maxPossible}</p>
                    <p class="text-lg opacity-80">${percentage}% — ${getGrade(percentage)}</p>
                </div>
            `;
        }

        interviewResultsDiv.innerHTML = html;
        interviewResultsDiv.scrollIntoView({ behavior: 'smooth' });
    }

    function getGrade(pct) {
        if (pct >= 80) return '🌟 Excellent';
        if (pct >= 60) return '👍 Good';
        if (pct >= 40) return '📈 Needs Improvement';
        return '🔄 Keep Practising';
    }

    // ─── INITIAL QUESTION ──────────────────────────────────────────
    async function getInitialQuestion() {
        try {
            const response = await fetch('/hr-round/initial-question');
            const data = await response.json();
            currentQuestion = data.question;
            questionDisplay.textContent = currentQuestion;
            questionCounterDiv.textContent = `Question 1 of 10`;
        } catch(e) {
            questionDisplay.textContent = 'Failed to load question. Please refresh.';
        }
    }

    // ─── BUTTON HANDLER ───────────────────────────────────────────
    startStopButton.addEventListener('click', () => {
        if (interviewComplete) return;
        if (isRecording) stopRecognition();
        else startRecognition();
    });

    // ─── INIT ─────────────────────────────────────────────────────
    getMedia();
    getInitialQuestion();
</script>

</body>
</html>