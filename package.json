{
  "name": "prepto",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node --use-env-proxy server.js",
    "dev": "node --use-env-proxy --watch server.js",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "check": "npm run build && npm run lint && npm test",
    "audit": "npm audit --omit=dev",
    "seed:bank": "node --use-env-proxy scripts/seed-question-bank.js",
    "test:browser": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/browser.test.js",
    "test:emulator": "node scripts/test-emulator.js",
    "verify:live": "node --use-env-proxy scripts/verify-live.js",
    "demo": "node scripts/demo-server.js",
    "demo:screenshots": "node scripts/demo-screenshots.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-session": "^1.18.2",
    "firebase-admin": "^14.5.0",
    "https-proxy-agent": "^7.0.6",
    "mammoth": "^1.11.0",
    "marked": "^15.0.12",
    "multer": "^2.0.2",
    "pdf-parse": "2.4.5",
    "pdfkit": "^0.17.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "puppeteer-core": "^25.13.0",
    "sanitize-html": "^2.17.0"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.12.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.33.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "jszip": "^3.10.1",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "middleware/**/*.js",
      "adapters/**/*.js",
      "routes/**/*.js",
      "controller/**/*.js",
      "services/**/*.js",
      "ats.js",
      "resumeGenerator.js",
      "careerGuidance.js",
      "utils/**/*.js",
      "demo/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov"
    ],
    "coverageProvider": "v8",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/emulator/"
    ]
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "get-uri": {
      "basic-ftp": "^6.2.3"
    }
  }
}
