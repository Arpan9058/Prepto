<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coding Test</title>
    <link rel="stylesheet" href="./stylesheet/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        /* Import Google font - Poppins */
        @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap");

        /* Custom Variables */
        :root {
            --primary-color: #3b141c;
            --secondary-color: #f3961c;
            --dark-color: #252525;
            --white-color: #fff;
            --light-gray-color: #f2f2f2;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, var(--primary-color) 0%, #5a1f2a 100%);
            color: var(--dark-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        /* Main Content Area */
        .main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

        .container {
            background-color: var(--white-color);
            padding: 3rem 2.5rem;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 500px;
            text-align: center;
            animation: slideUp 0.5s ease-out;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--primary-color);
        }

        .subtitle {
            font-size: 1rem;
            color: #999;
            margin-bottom: 2rem;
            font-weight: 400;
        }

        /* Logo Styling */
        .logo {
            width: 120px;
            height: auto;
            margin-bottom: 1.5rem;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(59, 20, 28, 0.15);
        }

        label {
            display: block;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 0.8rem;
            color: var(--dark-color);
            text-align: left;
        }

        select {
            width: 100%;
            padding: 1rem;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
            font-family: 'Poppins', sans-serif;
            appearance: none;
            background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path fill="%23f3961c" d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>');
            background-repeat: no-repeat;
            background-position: right 1rem center;
            background-size: 1.2rem;
            padding-right: 2.5rem;
            margin-bottom: 2rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        select:hover {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 3px rgba(243, 150, 28, 0.1);
        }

        select:focus {
            outline: none;
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 3px rgba(243, 150, 28, 0.2);
        }

        button {
            width: 100%;
            background: linear-gradient(135deg, var(--secondary-color) 0%, #e8860f 100%);
            color: var(--white-color);
            border: none;
            padding: 1rem 2rem;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(243, 150, 28, 0.3);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        button:hover {
            background: linear-gradient(135deg, #e8860f 0%, var(--secondary-color) 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(243, 150, 28, 0.4);
        }

        button:active {
            transform: translateY(0);
        }

        .form-group {
            margin-bottom: 1.5rem;
        }
    </style>
</head>

<body>

    <!-- Main Content -->
    <div class="main">
        
        <div class="container">
            <!-- Logo -->
            <img src="/images/WhatsApp Image 2025-03-01 at 07.23.51_0acb7dd0.jpg" alt="Prepto Logo" class="logo">
            
            <h1>Coding Test</h1>
            <p class="subtitle">Challenge yourself with coding problems</p>
            
            <form action="/coding-test/start-test" method="post">
                <div class="form-group">
                    <label for="language"><i class="fas fa-code"></i> Select Programming Language:</label>
                    <select name="language" id="language">
                        <% languages.forEach(function(language) { %>
                            <option value="<%= language %>"><%= language %></option>
                        <% }); %>
                    </select>
                </div>
                <button type="submit"><i class="fas fa-play"></i> Start Test</button>
            </form>
        </div>
    </div>

</body>

</html>
